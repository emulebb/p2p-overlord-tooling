{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord-tooling/run-summary/v1",
  "title": "Overlord Tooling Run Summary v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "runId",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "run-summary/v1"
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "mismatched",
        "incomplete"
      ]
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": true
    },
    "artifactPaths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
