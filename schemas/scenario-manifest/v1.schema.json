{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord-tooling/scenario-manifest/v1",
  "title": "Overlord Tooling Scenario Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "description"
  ],
  "properties": {
    "schemaVersion": {
      "const": "scenario-manifest/v1"
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarioKind": {
      "type": "string",
      "enum": [
        "legacy",
        "cell",
        "campaign"
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "kad2",
        "ed2k",
        "mixed"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "deterministic-private",
        "broad-private",
        "realnet-confidence"
      ]
    },
    "parity": {
      "type": "object",
      "properties": {
        "matrixId": {
          "type": "string",
          "minLength": 1
        },
        "cellId": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "planned"
          ]
        },
        "expectedBranch": {
          "type": "string",
          "minLength": 1
        },
        "comparisonMode": {
          "type": "string",
          "minLength": 1
        },
        "requiredArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredHarnessHooks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredAgentEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "harnessHookConfig": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summarySourceScenarioId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "campaign": {
      "type": "object",
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "planned"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scenarioId"
            ],
            "properties": {
              "scenarioId": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "seedBundle": {
      "type": "object",
      "properties": {
        "bundleId": {
          "type": "string",
          "minLength": 1
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "emuleHarness": {
      "type": "object",
      "properties": {
        "dynamicPreferenceKeys": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "seededPreferenceDefaults": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "properties": {
        "controlUrl": {
          "type": "string",
          "minLength": 1
        },
        "statsUrl": {
          "type": "string",
          "minLength": 1
        },
        "seedRequest": {
          "type": "object",
          "required": [
            "hash",
            "canonicalName",
            "size",
            "sourceCount"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "minLength": 1
            },
            "canonicalName": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sourceCount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
